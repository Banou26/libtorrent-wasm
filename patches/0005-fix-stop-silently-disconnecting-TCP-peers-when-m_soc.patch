From f23c70d4c55f88c780bf202d089e8d5ed2d218e4 Mon Sep 17 00:00:00 2001
From: Banou <me@banou.dev>
Date: Mon, 25 May 2026 20:38:00 +0900
Subject: [PATCH] =?UTF-8?q?fix:=20=F0=9F=90=9Bstop=20silently=20disconnect?=
 =?UTF-8?q?ing=20TCP=20peers=20when=20m=5Fsocket.available()=20unsupported?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 src/peer_connection.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/peer_connection.cpp b/src/peer_connection.cpp
index dad90b056..b874829e0 100644
--- a/src/peer_connection.cpp
+++ b/src/peer_connection.cpp
@@ -6159,8 +6159,14 @@ namespace libtorrent {
 			int buffer_size = int(m_socket.available(ec));
 			if (ec)
 			{
-				disconnect(ec, operation_t::available);
-				return;
+				// WASM: tolerate available() failure; skip the sync drain and
+				// let setup_receive() pull more bytes via async_read_some.
+				// FIONREAD is implemented JS-side since 0.2.2 so this rarely
+				// fires; the guard is defensive. Disconnecting here silently
+				// killed the peer (operation_t::available raised no
+				// peer_disconnect_alert), which made the failure invisible.
+				buffer_size = 0;
+				ec = error_code();
 			}
 
 #ifndef TORRENT_DISABLE_LOGGING
